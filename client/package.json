{
  "packageManager": "pnpm@11.6.0",
  "name": "timekeeper",
  "version": "5.3.5",
  "private": true,
  "description": "Timekeeper browser extension",
  "scripts": {
    "dev": "extension dev",
    "prebuild": "node build-tools/sync-version.js && node build-tools/sync-generated.js",
    "build": "extension build --browser chromium",
    "prebuild:firefox": "node build-tools/sync-version.js && node build-tools/sync-generated.js",
    "build:firefox": "extension build --browser firefox",
    "build:userscript": "node build-tools/build.js",
    "build:userscript:devel": "node build-tools/build.js --channel=devel",
    "clean": "rm -rf dist",
    "release": "bash build-tools/release.sh",
    "release:patch": "bash build-tools/release.sh patch",
    "release:minor": "bash build-tools/release.sh minor",
    "release:major": "bash build-tools/release.sh major",
    "release:prerelease": "bash build-tools/release.sh prerelease"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "clean-css-cli": "^5.6.3",
    "commit-and-tag-version": "^13.3.0",
    "esbuild": "^0.28.2",
    "extension": "^4.1.35",
    "http-server": "^14.1.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tabler/icons": "^3.49.0",
    "fflate": "^0.8.3"
  }
}
