{
  "manifest_version": 3,
  "name": "Timekeeper",
  "version": "5.3.8",
  "description": "Enhanced timestamp tool for YouTube videos with DVR/rewind enablement for live streams",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/extension-bridge.ts"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/timekeeper.ts"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "48": "assets/Kamo_48px.png",
    "64": "assets/Kamo_64px_Indexed.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/Kamo_64px_Indexed.png",
        "assets/Kamo_Eyebrow_64px_Indexed.png"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "firefox:browser_specific_settings": {
    "gecko": {
      "id": "timekeeper@kamotimestamps.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "personallyIdentifyingInfo",
          "browsingActivity",
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
