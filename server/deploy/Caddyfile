{
	servers {
		# Cloudflare proxies this site. Caddy only believes CF-Connecting-IP when the connection
		# really comes from one of Cloudflare's ranges (generated by deploy/remote-update.sh).
		import /etc/caddy/cloudflare-trusted-proxies.caddy
		client_ip_headers CF-Connecting-IP
	}
}

devel.kamotimestamps.com {
	# Let's Encrypt short-lived (~6 day) certificates; Caddy renews them automatically.
	tls {
		issuer acme {
			profile shortlived
		}
	}

	# Connections that did not come through Cloudflare cannot claim a country.
	import /etc/caddy/cloudflare-peer.caddy
	request_header @notViaCloudflare -CF-IPCountry

	# The app trusts these two headers (TRUST_PROXY_HEADERS=true) and listens on loopback only.
	# header_up replaces anything the client sent under the same name.
	# WebSocket upgrades (/sync/ws) are proxied automatically.
	reverse_proxy 127.0.0.1:8787 {
		header_up X-Client-IP {client_ip}
		header_up X-Client-Country {http.request.header.CF-IPCountry}
	}
}
