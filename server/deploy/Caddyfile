{
	# Cloudflare is the only client and connects over TCP 443, so Caddy opens no other port: no :80
	# redirect or HTTP-01 listener (certificates are installed by hand, below) and no HTTP/3 (UDP 443).
	auto_https off

	servers {
		protocols h1 h2
		# Cloudflare proxies this site. Caddy only believes CF-Connecting-IP when the connection
		# really comes from one of Cloudflare's ranges (generated by deploy/remote-update.sh).
		import /etc/caddy/cloudflare-trusted-proxies.caddy
		client_ip_headers CF-Connecting-IP
	}
}

# __TK_HOSTNAME__ is replaced with the environment's hostname by deploy/remote-update.sh.
https://__TK_HOSTNAME__ {
	# Cloudflare Origin CA certificate (infra/, delivered by deploy.sh). Only Cloudflare trusts it, which
	# is fine: Cloudflare is the only client, in "Full (strict)" mode.
	# Authenticated Origin Pulls: refuse any connection that does not present the client certificate
	# Cloudflare was given for this hostname (infra/ uploads it; aop-client.pem is its public half).
	tls /etc/caddy/origin/origin.pem /etc/caddy/origin/origin.key {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/origin/aop-client.pem
		}
	}

	# Connections that did not come through Cloudflare cannot claim a country.
	import /etc/caddy/cloudflare-peer.caddy
	request_header @notViaCloudflare -CF-IPCountry -CF-IPCity -CF-Region-Code

	# The app trusts these headers (TRUST_PROXY_HEADERS=true) and listens on loopback only.
	# header_up replaces anything the client sent under the same name.
	# WebSocket upgrades (/sync/ws) are proxied automatically.
	reverse_proxy 127.0.0.1:8787 {
		header_up X-Client-IP {client_ip}
		header_up X-Client-Country {http.request.header.CF-IPCountry}
		header_up X-Client-City {http.request.header.CF-IPCity}
		header_up X-Client-Region {http.request.header.CF-Region-Code}
		# While the app restarts (a deploy takes a second or two) keep retrying the connection, so a
		# request made then waits for it and succeeds instead of being answered with a 502.
		lb_try_duration 20s
		lb_try_interval 250ms
	}
}
