[Unit]
Description=Timekeeper sync server
After=network-online.target
Wants=network-online.target

[Service]
User=timekeeper
Group=timekeeper
WorkingDirectory=/opt/timekeeper/server
EnvironmentFile=/etc/timekeeper/server.env
Environment=NODE_ENV=production
Environment=DATABASE_PATH=/var/lib/timekeeper/timekeeper.db
ExecStart=/usr/local/bin/node src/index.ts
Restart=always
RestartSec=2

StateDirectory=timekeeper
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
