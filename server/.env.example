# Google OAuth client ID (Web application) whose authorized redirect URI is https://www.youtube.com/
GOOGLE_CLIENT_ID=

# At least 32 characters; signs access tokens. Generate with: openssl rand -base64 48
JWT_SECRET=

# Comma-separated origins allowed to call the API from a browser
ALLOWED_ORIGINS=https://www.youtube.com

# Public origin of this server, without a trailing slash. The landing page only accepts requests from it.
PUBLIC_ORIGIN=http://localhost:8787

# Set to true only behind a reverse proxy that sets X-Client-IP / X-Client-Country (and strips any
# client-supplied copies), with HOST=127.0.0.1. Otherwise sessions show the socket address only.
TRUST_PROXY_HEADERS=false

HOST=0.0.0.0
PORT=8787
DATABASE_PATH=./data/timekeeper.db
