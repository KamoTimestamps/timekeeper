# Credentials for tofu come from the 1Password Automation vault when you cd in; nothing is written to disk.
# Setup: README.md ("Credentials"). The Tailscale auth key is not stored: it is single-use, so export
# TF_VAR_tailscale_auth_key by hand for the apply that creates a droplet.

# State bucket (DigitalOcean Spaces, S3-compatible), used by the backend in envs/*/main.tf.
AWS_ACCESS_KEY_ID=$(op read "op://Automation/timekeeper-infra-tfstate/access_key_id") \
  || log_error "cannot read timekeeper-infra-tfstate from 1Password (unlocked and signed in?)"
AWS_SECRET_ACCESS_KEY=$(op read "op://Automation/timekeeper-infra-tfstate/secret_access_key") || true
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY

# DigitalOcean API token, used by the digitalocean provider.
DIGITALOCEAN_TOKEN=$(op read "op://Automation/timekeeper-infra-digitalocean/credential") \
  || log_error "cannot read timekeeper-infra-digitalocean from 1Password; create it (see README.md)"
export DIGITALOCEAN_TOKEN

# Cloudflare API token (Zone:Read + DNS:Edit on kamotimestamps.com), used by the cloudflare provider.
CLOUDFLARE_API_TOKEN=$(op read "op://Automation/timekeeper-infra-cloudflare/credential") \
  || log_error "cannot read timekeeper-infra-cloudflare from 1Password; create it (see README.md)"
export CLOUDFLARE_API_TOKEN
